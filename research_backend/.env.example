# =============================================================================
# research_backend/.env.example
# -----------------------------------------------------------------------------
# Spec: FEATURE-001-m1-infra — Task T010 (Owner: Dev.cai.1)
#
# Copy this file to `.env` and fill in the secrets before running
# `uvicorn app.main:app` (or `docker compose up backend`).
#
# The application fails closed at startup (constitution I) if any of the
# required variables are missing or fail validation — see
# `app/config.py` for the validator definitions.
#
# Sections:
#   1. Service identity
#   2. HTTP server
#   3. Postgres (data-model.md §Thread + §Message)
#   4. Redis (data-model.md §User + LangGraph checkpoint)
#   5. Langfuse (ADR-0006 OTel API; FR-009 trace writes)
#   6. Anonymous cookie (FR-011a)
#   7. Rate limit (FR-011b)
#   8. Startup healthcheck
# =============================================================================


# ---- 1. Service identity --------------------------------------------------
SERVICE_NAME=research-backend
ENVIRONMENT=development
LOG_LEVEL=INFO


# ---- 2. HTTP server -------------------------------------------------------
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
# Comma-separated allow-list. Local dev defaults match the frontend service
# in `deploy/docker-compose.yml`. Production MUST be set explicitly.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ---- 3. Postgres (REQUIRED, constitution I fail-closed) ------------------
# The application will reject weak passwords ("postgres", "changeme",
# "password", "12345678") at startup. Set a strong secret (≥ 8 chars).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=research
POSTGRES_USER=research
POSTGRES_PASSWORD=replace-with-strong-secret-min-8-chars


# ---- 4. Redis (REQUIRED for US-2 / US-4) ---------------------------------
# M1 launches even without redis being up (no consumer yet); but the URL
# MUST be syntactically valid. Dev.cai.4 will wire real connections at
# T023 (rate-limit) + T030 (LangGraph checkpoint saver).
REDIS_URL=redis://redis:6379/0


# ---- 5. Langfuse (REQUIRED, ADR-0006 OTel API) ---------------------------
# Public + secret keys MUST be set; weak defaults like `pk-test` are accepted
# only when ENVIRONMENT=development. Switch LANGFUSE_ENABLED=false to run
# without trace writes (logs will emit a warning).
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
LANGFUSE_HOST=http://langfuse-server:3001
LANGFUSE_OTEL_ENDPOINT=http://langfuse-server:3001/api/public/otel
LANGFUSE_ENABLED=true


# ---- 6. Anonymous cookie (FR-011a) ---------------------------------------
# Cookie name MUST match what the frontend (`research_frontend/lib/api.ts`)
# reads. Max-Age is in seconds (default 2,592,000 = 30 days).
USER_ID_COOKIE_NAME=user_id
USER_ID_COOKIE_MAX_AGE_SECONDS=2592000


# ---- 7. Rate limit (FR-011b) ---------------------------------------------
# Per (IP hash + user_id) tuple:
#   - rate_limit_per_minute: requests/minute cap
#   - rate_limit_per_hour:   requests/hour cap
# Both MUST be > 0. Production tuning lives in ops runbooks (M3+).
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100


# ---- 8. Startup healthcheck ---------------------------------------------
# `task dev:up` waits at most this long for all 5 services to be healthy
# before failing the boot. Lower in CI for fast feedback loops.
STARTUP_TIMEOUT_SECONDS=120