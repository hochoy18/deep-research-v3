# =============================================================================
# research_backend/.env.example — local dev environment template
# =============================================================================
# Constitution I (Security-First): NEVER commit real secrets. Copy this file
# to `.env` and fill in placeholder values. The pydantic-settings loader
# (T017 / config.py) refuses to start when any required value is missing or
# uses a `<YOUR_…>` placeholder unchanged (FR-004).
#
# Spec traceability: FR-004 (env validation), FR-011a (anonymous cookie),
# FR-011b (IP+user_id rate limit), FR-022 (input whitelist),
# ADR-0003 (Postgres/Redis), ADR-0006 (Langfuse v5 OTel),
# ADR-0009 (v1 no-auth), data-model.md §User (30-day TTL)
# =============================================================================

# ---- Runtime metadata ----------------------------------------------------
# Triple: env / service / log level. structlog (T026) injects these into every
# log line (constitution VII).
APP_ENV=development
APP_NAME=research-backend
APP_VERSION=0.1.0
APP_LOG_LEVEL=INFO
APP_PORT=8000
APP_HOST=0.0.0.0
# uvicorn reload + JSON access log toggle (dev only)
APP_RELOAD=true
APP_DEBUG=false

# ---- Server (CORS / trusted hosts) ---------------------------------------
# Comma-separated origins allowed via CORS; matches frontend docker-compose
# port (T012). Production MUST replace with the real public origin.
APP_CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_CORS_ALLOW_CREDENTIALS=true
# Trust X-Forwarded-* (only behind a known proxy; off for local dev)
APP_TRUST_PROXY=false

# ---- Anonymous user identity (FR-011a, ADR-0009, data-model §1) --------
# HMAC signing key for the anonymous user_id cookie. MUST be ≥ 32 random
# bytes hex/base64. For local dev any non-empty placeholder works; rotation
# invalidates all live sessions.
USER_COOKIE_NAME=user_id
USER_COOKIE_SIGNING_KEY=<YOUR_COOKIE_SIGNING_KEY_AT_LEAST_32_BYTES>
USER_COOKIE_TTL_SECONDS=2592000       # 30 days (spec Q2)
USER_COOKIE_SECURE=false              # set true in production (HTTPS)
USER_COOKIE_SAMESITE=lax              # "lax" | "strict" | "none"
USER_COOKIE_HTTPONLY=true

# ---- Rate limiting (FR-011b / spec Q3) -----------------------------------
# Sliding-window IP+user_id (ADR-0003 Redis backend).
# Thresholds: 10 req / minute, 100 req / hour.
RATELIMIT_ENABLED=true
RATELIMIT_WINDOW_PER_MINUTE=60
RATELIMIT_THRESHOLD_PER_MINUTE=10
RATELIMIT_WINDOW_PER_HOUR=3600
RATELIMIT_THRESHOLD_PER_HOUR=100
# Redis key prefix (multi-tenant ready; M1 single-tenant)
RATELIMIT_KEY_PREFIX=rl:m1:

# ---- Postgres (ADR-0003 / data-model §2/§3) -----------------------------
# Matches deploy/docker-compose.yml (T012) defaults. DATABASE_URL is the
# SQLAlchemy async DSN consumed by app/db/session.py (T020).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=research
POSTGRES_USER=research
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_POOL_TIMEOUT_SECONDS=10
POSTGRES_SSLMODE=prefer                # require/verify-full in production

# ---- Redis (ADR-0003 / rate limit + LangGraph checkpoint) ---------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD_OR_EMPTY>
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT_SECONDS=5
# Logical DB for LangGraph RedisCheckpointSaver (T030); keep separate from
# rate-limit DB to ease ops / wipe scopes.
REDIS_CHECKPOINT_DB=1
REDIS_CHECKPOINT_KEY_PREFIX=lg:ckpt:m1:

# ---- Langfuse (self-hosted, ADR-0006, data-model §4) --------------------
# Container exposes 3001 in deploy/docker-compose.yml (T012).
LANGFUSE_ENABLED=true
LANGFUSE_BASE_URL=http://langfuse-server:3001
LANGFUSE_PUBLIC_KEY=<YOUR_LANGFUSE_PUBLIC_KEY>
LANGFUSE_SECRET_KEY=<YOUR_LANGFUSE_SECRET_KEY>
# OTel exporter endpoint exposed by langfuse-server v4.59.0.
LANGFUSE_OTEL_EXPORTER_OTLP_ENDPOINT=http://langfuse-server:3001/api/public/otel/v1/traces
LANGFUSE_OTEL_EXPORTER_OTLP_HEADERS=<YOUR_OTEL_HEADER_BASE64_PUBLICKEY:SECRETKEY>
LANGFUSE_TRACE_SAMPLE_RATIO=1.0        # 0.0–1.0; lower only under load

# ---- SSE / streaming -----------------------------------------------------
# max token chunks per message; bound the message store (data-model §3 ≤
# 100k chars). Frontend EventSource (T060) reads message_id back.
SSE_PING_INTERVAL_MS=15000
SSE_RETRY_BACKOFF_MS=2000
SSE_HEARTBEAT_TIMEOUT_SECONDS=120

# ---- Observability (constitution VII) ------------------------------------
# All three MUST be set together; missing any one of these degrades to
# stdout JSON only (T026).
OTEL_ENABLED=true
OTEL_SERVICE_NAME=research-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://langfuse-server:3001/api/public/otel/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=<YOUR_OTEL_HEADER_BASE64_PUBLICKEY:SECRETKEY>
OTEL_RESOURCE_ATTRIBUTES=service.namespace=hochoy,deployment.environment=m1

# ---- Input whitelist (FR-022 / contracts MessageCreate) ------------------
# Hard ceiling on a single message content length (chars).
INPUT_MAX_CONTENT_LENGTH=100000
# Allowed character classes: ascii + common CJK; control chars except
# newline are stripped pre-agent.
INPUT_ALLOW_NON_ASCII=true
INPUT_STRIP_CONTROL_CHARS=true

# ---- Startup behavior ----------------------------------------------------
# Skip alembic migrations on cold start (use only when migrations are
# already applied). M1 default = false so first `task dev:up` self-heals.
APP_SKIP_MIGRATIONS=false
# Health-check grace period (seconds) before uvicorn refuses connections.
APP_STARTUP_GRACE_SECONDS=30

# =============================================================================
# Notes
# =============================================================================
# - Replace every `<YOUR_…>` placeholder before running the container.
# - production smoke test: `uv run app.main` should refuse with
#   `ValidationError: … <YOUR_COOKIE_SIGNING_KEY_AT_LEAST_32_BYTES>` —
#   that confirms constitution I is enforced at startup, not at runtime.
# - Rotation: USER_COOKIE_SIGNING_KEY rotation invalidates every live
#   session on the next request → users get new UUID v4 issued.
# - For CI (T009/T071) the same env names MUST be exported in
#   `.github/workflows/ci.yml` with dummy values that pass pydantic
#   validation (use 64-char hex).
