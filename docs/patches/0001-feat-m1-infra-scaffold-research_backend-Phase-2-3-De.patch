+addopts = [
+    "-ra",
+    "--strict-markers",
+    "--strict-config",
+    "--asyncio-mode=auto",
+    "-p",
+    "asyncio",
+]
+testpaths = ["tests"]
+pythonpath = ["."]
+markers = [
+    "critical_path_1: query submission → mock SSE stream end-to-end",
+    "critical_path_2: thread create / list / reopen (user_id filtered)",
+    "critical_path_3: anonymous cookie generation + rate limiting",
+    "critical_path_4: observability trace write",
+    "unit: pure unit test (no external services)",
+    "integration: requires docker-compose stack or stubbed deps",
+]
+
+# ---------------------------------------------------------------------------
+# Coverage configuration — Constitution III (key path ≥80%)
+# Critical-path sources must remain explicitly listed below
+# ---------------------------------------------------------------------------
+[tool.coverage.run]
+branch = true
+source = [
+    "app",
+]
+omit = [
+    "tests/*",
+    "app/__init__.py",
+]
+
+[tool.coverage.report]
+show_missing = true
+skip_covered = false
+fail_under = 80
+exclude_lines = [
+    "pragma: no cover",
+    "raise NotImplementedError",
+    "if TYPE_CHECKING:",
