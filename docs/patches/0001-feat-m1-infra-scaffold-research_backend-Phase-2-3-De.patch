+authors = [
+    { name = "hochoy", email = "dev@hochoy.example" },
+]
+readme = "README.md"
+requires-python = ">=3.12,<3.13"
+license = { text = "Proprietary" }
+
+# ---------------------------------------------------------------------------
+# Runtime dependencies — minimal M1 mock service (constitution VIII simplicity)
+# ---------------------------------------------------------------------------
+dependencies = [
+    # Web framework (research.md R9, ADR-0010 no auth)
+    "fastapi>=0.115.0",
+    "uvicorn[standard]>=0.30.0",
+
+    # Settings & validation (constitution I launch-time validation)
+    "pydantic>=2.9.0",
+    "pydantic-settings>=2.5.0",
+
+    # Observability (ADR-0006 Langfuse OTel)
+    "structlog>=24.4.0",
+    "langfuse>=3.0.0",
+
+    # Future M2+ hooks; M1 keeps stubs only
+    # "langgraph>=0.2.0",   # Dev.cai.2 wires in Phase 2 T029/T030
+    # "sqlalchemy[asyncio]>=2.0.36",  # Dev.cai.2 wires in Phase 2 T019/T020
+    # "redis>=5.1.0",        # Dev.cai.4 wires in Phase 2 T023
+]
+
+# ---------------------------------------------------------------------------
+# Dev dependencies — Constitution III (Test-First, NON-NEGOTIABLE)
+# Critical-path coverage gate: 80% on the 4 declared paths
+# ---------------------------------------------------------------------------
+[project.optional-dependencies]
+dev = [
+    # Test framework (TDD red-green-refactor loop)
+    "pytest>=8.3.0",
+    "pytest-asyncio>=0.24.0",
+    "pytest-cov>=5.0.0",
+
+    # HTTP testing for /health, /threads endpoints
+    "httpx>=0.27.0",
+    "asgi-lifespan>=2.1.0",
+
+    # Test fixtures / determinism
+    "factory-boy>=3.3.0",
+    "freezegun>=1.5.0",
+    "fakeredis>=2.26.0",
+
+    # Lint / format (constitution II/III consistency)
+    "ruff>=0.7.0",
+
+    # SAST / SCA (constitution I)
+    "bandit[toml]>=1.7.10",
+    "pip-audit>=2.7.0",
+]
+
+# ---------------------------------------------------------------------------
+# uv 0.4+ lockfile metadata (research.md R9)
+# ---------------------------------------------------------------------------
+[tool.uv]
+managed = true
+
+# ---------------------------------------------------------------------------
+# Pytest configuration — Constitution III Test-First
+# Critical paths (4) marked via pytest markers
+# ---------------------------------------------------------------------------
+[tool.pytest.ini_options]
