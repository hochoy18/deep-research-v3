# =============================================================================
# research_frontend/.env.example — local dev environment template
# =============================================================================
# Constitution I (Security-First): NEVER commit real secrets. Copy this file
# to `.env.local` for local dev; Next.js loads `.env*` files automatically
# only in non-production builds.
#
# Variable naming conventions (Next.js 16):
#   - NEXT_PUBLIC_*  → exposed to the BROWSER bundle (build-time inlined)
#   - everything else → server-side / build-time only (never reaches user)
#
# Spec traceability: contracts/openapi.yaml base URL (T012 ports),
# ADR-0007 (Tailwind v4), ADR-0006 (Langfuse v5), data-model §2 (Thread
# deep-links via /threads/[thread_id])
# =============================================================================

# ---- Runtime metadata ----------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=hochoy-deep-research
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_APP_ENV=m1

# ---- Backend API base URL (contracts/openapi.yaml) -----------------------
# Browser-facing origin for fetch / EventSource (lib/api.ts, T035).
# In dev, points at the host machine; in docker-compose (T012) it
# points at the service name.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side origin used by Next.js Route Handlers / Server Components
# to bypass the port mapping and talk to the backend service directly.
# Same value as NEXT_PUBLIC_API_URL when running outside docker.
API_INTERNAL_URL=http://localhost:8000

# ---- Langfuse (browser-only "view trace" link) ---------------------------
# Link-out from a message to its Langfuse observation in the UI.
# Spec FR-009 / SC-004 — frontend never ingests the Langfuse SDK; it
# only deep-links. Only PUBLIC-safe values belong here.
NEXT_PUBLIC_LANGFUSE_URL=http://localhost:3001
NEXT_PUBLIC_LANGFUSE_PUBLIC_KEY=<YOUR_LANGFUSE_PUBLIC_KEY>

# ---- Anonymous user identity (mirrors backend cookie name, FR-011a) -----
# The cookie is set by the BACKEND on its own domain; the frontend just
# reads it via document.cookie + credentials:'include'. Keep names in
# sync with backend .env.example (T010).
NEXT_PUBLIC_USER_COOKIE_NAME=user_id
NEXT_PUBLIC_USER_COOKIE_TTL_SECONDS=2592000

# ---- SSE / streaming (FR-022, contracts MessageCreate) ------------------
# EventSource retry hint (ms) — spec SC-003 keeps first-byte ≤ 500ms;
# reconnect back-off is browser default (3s) unless overridden here.
NEXT_PUBLIC_SSE_RETRY_INTERVAL_MS=3000
# Hard cap on stream duration (seconds); matches backend heartbeat.
NEXT_PUBLIC_SSE_HEARTBEAT_TIMEOUT_SECONDS=120

# ---- Telemetry from the BROWSER (constitution VII) ----------------------
# Anonymous page-view beacon. Disabled by default; flip to \"true\" only
# once the consent banner ships in M2+.
NEXT_PUBLIC_TELEMETRY_ENABLED=false
NEXT_PUBLIC_TELEMETRY_ENDPOINT=
NEXT_PUBLIC_TELEMETRY_SAMPLE_RATIO=0.0

# ---- Feature flags (kept server-side; surfaced via /api/config) ---------
# Server-only flags consumed by Next.js Route Handlers.
FEATURE_ECHO_NODE_ENABLED=true           # spec Q1 — always on for M1
FEATURE_THREAD_DEEPLINK_ENABLED=true     # spec FR-010 — /threads/[id]
FEATURE_RATE_LIMIT_BANNER_ENABLED=true    # spec FR-011b — surface 429

# ---- CDN / asset overrides (optional) -----------------------------------
# Stub. M1 runs fully local; leave empty. M3+ may override per-env.
NEXT_PUBLIC_ASSET_BASE_URL=
NEXT_PUBLIC_CDN_IMAGE_HOST=

# =============================================================================
# Notes
# =============================================================================
# - Copy to `.env.local` for `pnpm dev`; docker build reads from the
#   same file mounted into the frontend container (T014).
# - Browser-visible URLs MUST be reachable from the user's browser.
#   Inside docker-compose (T012) the hostname `backend` is NOT
#   resolvable from the browser; the dev override file SHOULD set
#   NEXT_PUBLIC_API_URL=http://localhost:8000 instead.
# - All `<YOUR_…>` placeholders MUST be replaced before deploy; CI
#   runs `gitleaks` (T005/T075) and will block the PR if any remain.
